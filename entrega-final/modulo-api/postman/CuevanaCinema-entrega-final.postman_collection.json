                  "const msg = pm.response.json().error.mensaje;",
                  "pm.test(\"Avisa del ROLLBACK en PostgreSQL\", () => pm.expect(msg).to.include(\"ROLLBACK\"));",
                  "pm.environment.set(\"id_venta_revertida\", msg.match(/venta (\\d+)/)[1]);"
                ]
              }
            }
