# Copie este archivo como .env (queda fuera de Git) y pegue sus cadenas de conexión.
# NUNCA suba el archivo .env con contraseñas reales.

# PostgreSQL (Neon) > proyecto CuevanaCinema > Connect > base cine_avance1.
# Use la cadena DIRECTA (desmarque "Connection pooling").
PG_URL=postgresql://USUARIO:CONTRASENA@HOST/cine_avance1?sslmode=require

# MongoDB (Atlas) > ClusterBaseDatos2 > Connect > Drivers (cambie <db_password> por la contraseña).
MONGO_URL=mongodb+srv://USUARIO:CONTRASENA@HOST/?retryWrites=true&w=majority
MONGO_DB=cine_avance2
