    {
      "name": "3. Flujo programar → vender → cancelar (C2)",
      "item": [
        {
          "name": "Programar función + requisitos (PG y luego Mongo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/integracion/funciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "integracion",
                "funciones"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_sala\": {{sala}},\n  \"id_pelicula\": 2,\n  \"fecha_hora_inicio\": \"{{fecha_libre}}\",\n  \"version\": \"SUBTITULADA\",\n  \"requisitos\": {\n    \"experiencias\": [\n      \"SUBTITULOS\"\n    ],\n    \"requisitos\": [\n      {\n        \"componente\": \"SUBTITULOS\",\n        \"obligatorio\": true,\n        \"especificacion\": {\n          \"idioma\": \"es\",\n          \"tipo\": \"SDH\"\n        }\n      }\n    ],\n    \"dcp\": {\n      \"paquete\": \"POSTMAN_FTR-1_F_ES-XX_2K\",\n      \"resolucion\": \"2K\",\n      \"cifrado\": false\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha aleatoria a +20–60 días a las 11:00 y sala 2D activa: no choca con los datos de prueba (C9, C11)",
                  "const dias = 20 + Math.floor(Math.random() * 41);",
                  "const d = new Date(Date.now() + dias * 86400000);",
                  "pm.collectionVariables.set('fecha_libre', d.toISOString().slice(0, 10) + ' 11:00');",
                  "const salas = [1, 2, 5, 7, 8];",
                  "pm.collectionVariables.set('sala', salas[Math.floor(Math.random() * salas.length)]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('id_funcion', j.id_funcion);",
                  "pm.collectionVariables.set('oid_requisitos', j.requisitos._id);",
                  "pm.test('Requisitos PENDIENTE en MongoDB', () => pm.expect(j.requisitos.verificacion.estado).to.eql('PENDIENTE'));",
                  "pm.test('La copia de la función viene de PostgreSQL', () => pm.expect(j.requisitos.id_funcion).to.eql(j.id_funcion));"
                ]
              }
            }
          ]
        },
