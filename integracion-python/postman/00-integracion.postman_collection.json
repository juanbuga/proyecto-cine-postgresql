                  "pm.test('NO_APLICA en MongoDB', () => pm.expect(j.mongodb.requisitos_proyeccion.verificacion.estado).to.eql('NO_APLICA'));",
                  "pm.test('Copias coinciden', () => pm.expect(j.copias_coinciden).to.be.true);"
                ]
              }
            }
          ]
