                  "pm.test('MongoDB conectado a cine_avance2', () => { pm.expect(j.mongodb.conectado).to.be.true; pm.expect(j.mongodb.base).to.eql('cine_avance2'); });",
                  "pm.test('Están los 4 colecciones', () => pm.expect(j.mongodb.colecciones).to.include.members(['fichas_tecnicas_peliculas','requisitos_proyeccion','resenas_peliculas','reportes_incidentes']));"
                ]
