                  "const j = pm.response.json();",
                  "pm.test('Cancelada en PostgreSQL', () => pm.expect(j.postgresql.cancelada).to.be.true);",
                  "pm.test('Sincronizada en MongoDB', () => pm.expect(j.mongodb.sincronizado).to.be.true);"
                ]
