# Copie este archivo como .env (queda fuera de Git) y pegue sus cadenas de conexión.
# En Google Colab no se usa .env: cree los mismos nombres en "Secretos" (icono de la llave).

# Neon > proyecto CuevanaCinema > rama "integracion" > Connect > base cine_avance1.
# Use la cadena DIRECTA (desmarque "Connection pooling"): los scripts de carga y
# SET LOCAL TIME ZONE funcionan mejor sin el pooler.
PG_URL=postgresql://USUARIO:CONTRASENA@HOST/cine_avance1?sslmode=require

# Atlas > ClusterBaseDatos2 > Connect > Drivers (cambie <db_password> por la contraseña).
MONGO_URL=mongodb+srv://USUARIO:CONTRASENA@HOST/?retryWrites=true&w=majority
MONGO_DB=cine_avance2
